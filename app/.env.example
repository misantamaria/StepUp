# ============================================
# CONFIGURACIÓN STEPUP - ESTRUCTURAS DE DATOS
# ============================================
# Copia este archivo a .env y configura tus valores reales

# ============================================
# DJANGO BÁSICO
# ============================================
# Genera una clave secreta segura para producción
# Puedes generar una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# BASE DE DATOS
# ============================================
# Para MySQL/MariaDB (producción)
DB_ENGINE=django.db.backends.mysql
DB_NAME=stepup_db
DB_USER=root
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Para SQLite (desarrollo) - comenta las líneas MySQL y usa:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# ============================================
# CONFIGURACIÓN DE EMAIL
# ============================================
# Backend de email (para desarrollo usa console, para producción usa smtp)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend  # Para desarrollo (imprime en consola)

# Configuración SMTP (Gmail, Outlook, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Credenciales del servidor de correo
# Para Gmail, necesitas una "App Password" (Contraseña de aplicación)
# Instrucciones: https://support.google.com/accounts/answer/185833
EMAIL_HOST_USER=mi.santamaria@upm.es
EMAIL_HOST_PASSWORD=your-app-password-here

# Emails por defecto
DEFAULT_FROM_EMAIL=mi.santamaria@upm.es
SERVER_EMAIL=mi.santamaria@upm.es

# ============================================
# USUARIOS PREDEFINIDOS
# ============================================
# Emails de usuarios predefinidos del sistema
ADMIN_EMAIL=admin@upm.es
PROFESOR_EMAIL=profesor@upm.es
ALUMNO_EMAIL=alumno@alumnos.upm.es

# ============================================
# CONFIGURACIÓN DE TESTS
# ============================================
# Ruta a los archivos XML de preguntas
QUESTIONS_PATH=tests/preguntas/

# ============================================
# CONFIGURACIÓN DE PRODUCCIÓN (OPCIONAL)
# ============================================
# Configuración adicional para entorno de producción

# Seguridad
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# Archivos estáticos y media
# STATIC_ROOT=/var/www/stepup/static/
# MEDIA_ROOT=/var/www/stepup/media/
# MEDIA_URL=/media/
