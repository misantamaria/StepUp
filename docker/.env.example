# =============================================================================
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO PARA STEPUP
# =============================================================================
# Copia este archivo a .env y configura tus valores reales
# 
# Para Docker: Coloca el .env en la carpeta /docker 
# =============================================================================

# =============================================================================
# CONFIGURACIÓN DE DJANGO
# =============================================================================

# Clave secreta de Django (OBLIGATORIO cambiar en producción)
# Genera una nueva con: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=dev-secret-key-change-me-in-production

# Modo debug (True para desarrollo, False para producción)
DEBUG=True

# Hosts permitidos (separados por comas, sin espacios)
ALLOWED_HOSTS=localhost,127.0.0.1,midominio.com

# Número máximo de usuarios concurrentes (para gunicorn)
MAX_USERS=4

# =============================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# =============================================================================

DB_NAME=PIE_ED
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306

# =============================================================================
# CONFIGURACIÓN DE SERVIDOR (DOCKER)
# =============================================================================

# Puerto en el que correrá Django
DJANGO_PORT=8864

# Módulo WSGI de Django (normalmente no necesitas cambiar esto)
DJANGO_WSGI_MODULE=stepup_config.wsgi:application

# Usuario y grupo para el contenedor (usa tu UID/GID local)
# Para obtener tu UID: id -u
# Para obtener tu GID: id -g
UID=1000
GID=1000



# =============================================================================
# CONFIGURACIÓN DE EMAIL
# =============================================================================

# Backend de email (usa console para desarrollo local sin servidor SMTP)
# Opciones: django.core.mail.backends.smtp.EmailBackend (producción)
#          django.core.mail.backends.console.EmailBackend (desarrollo)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Configuración del servidor SMTP (solo si usas smtp.EmailBackend)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Credenciales de email (NUNCA incluir contraseñas reales en este archivo)
EMAIL_HOST_USER=tu-email@ejemplo.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion

# Emails por defecto
DEFAULT_FROM_EMAIL=tu-email@ejemplo.com
SERVER_EMAIL=tu-email@ejemplo.com

# =============================================================================
# EMAILS DE ADMINISTRADORES (para la vista de contacto)
# =============================================================================

# Email del administrador principal
ADMIN_EMAIL=admin@example.com